{
  "name": "fb-autopost-master",
  "version": "1.0.0",
  "description": "Tool Quản Lý & Đăng Bài Facebook Tự Động Hàng Loạt",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "web": "node server/server.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "build:win": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.tris.fbautopost",
    "productName": "FB AutoPost Master",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "server/**/*",
      "web/**/*",
      "package.json"
    ]
  },
  "keywords": [
    "facebook",
    "autopost",
    "automation",
    "browser-hub"
  ],
  "author": "Tris",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "playwright-core": "^1.58.2"
  },
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^26.4.0"
  }
}
